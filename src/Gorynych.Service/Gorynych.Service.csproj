<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Gorynych.Service</RootNamespace>
    <AssemblyName>Gorynych.Service</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The AHP face (docs/ahp-face.md): Microsoft's types and reducers, pinned, and Kestrel's WebSockets. -->
    <PackageReference Include="Microsoft.VisualStudioCode.AgentHostProtocol" Version="1.0.0" />
    <PackageReference Include="Microsoft.VisualStudioCode.AgentHostProtocol.Abstractions" Version="1.0.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gorynych.Acp\Gorynych.Acp.csproj" />
    <ProjectReference Include="..\Gorynych.Adapters.Kimi\Gorynych.Adapters.Kimi.csproj" />
    <ProjectReference Include="..\Gorynych.Adapters.Claude\Gorynych.Adapters.Claude.csproj" />
    <ProjectReference Include="..\Gorynych.Adapters.Codex\Gorynych.Adapters.Codex.csproj" />
    <ProjectReference Include="..\Gorynych.Adapters.Dsh\Gorynych.Adapters.Dsh.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with Gorynych.Outside: the outside tools, the ancestry walk, the detached start. -->
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gorynych.Tests" />
  </ItemGroup>
</Project>
